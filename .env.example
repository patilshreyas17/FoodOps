# FoodOps Environment Configuration
# Copy this file to .env and fill in your actual values

# Server Configuration
SERVER_PORT=5454

# MySQL Database Configuration
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=foodops
MYSQL_USER=user
MYSQL_PASSWORD=password

# Spring Boot Configuration
SPRING_DATASOURCE_URL=jdbc:mysql://mysql:3306/foodops?allowPublicKeyRetrieval=true&useSSL=false
SPRING_DATASOURCE_USERNAME=user
SPRING_DATASOURCE_PASSWORD=password
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_JPA_SHOW_SQL=true

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://192.168.1.38:3000,http://192.168.1.103:3000

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-that-is-at-least-256-bits-long
JWT_EXPIRATION=86400000

# Email Configuration
EMAIL=your-email@gmail.com
EMAIL_APP_PASSWORD=your-app-password
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587

# Microservices Ports
DISCOVERY_SERVICE_PORT=8761
GATEWAY_SERVICE_PORT=9090
PAYMENT_SERVICE_PORT=9091

# Payment Gateway Configuration
RAZORPAY_API_KEY=your-razorpay-key
RAZORPAY_API_SECRET=your-razorpay-secret
PAYMENT_CALLBACK_URL=http://localhost:3000/payment/callback

# Frontend Environment Variables
VITE_API_URL=/proxy
VITE_GOOGLE_MAPS_API_KEY=your-google-maps-api-key
VITE_RAPID_API_KEY=your-rapid-api-key

# Application URLs
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:5454

# File Upload Configuration
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE_PATH=logs/foodops.log

# Redis Configuration (for caching/sessions)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Production Settings
NODE_ENV=development
DEBUG=false
